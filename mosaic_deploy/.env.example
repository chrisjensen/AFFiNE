# SSH Configuration for Coolify Server
# Copy this file to .env and fill in your values

# SSH connection to Coolify server
# Format: user@hostname or user@ip
SSH_HOST=root@coolify.example.com

# SSH port (default: 22)
# SSH_PORT=22

# Local port for SSH tunnel (default: 5000)
# Change if 5000 conflicts with something on your machine
# LOCAL_REGISTRY_PORT=5000

# Image name (default: affine)
# IMAGE_NAME=affine

# Build tag (default: git short hash)
# Uncomment to use a custom tag instead of git hash
# BUILD_TAG=v1.0.0

# Registry authentication (required)
# Use the same credentials you created with htpasswd on the server
REGISTRY_USER=your_username
REGISTRY_PASSWORD=your_password
